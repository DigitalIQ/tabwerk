{
  "manifest_version": 3,
  "name": "Tabwerk",
  "version": "0.5.0",
  "description": "Tabs finden, gruppieren, sortieren und entdoppeln. Webseiten beobachten. Jeden Stand sichern. Entscheidungen trifft Jev über OpenRouter oder TypeSafe.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tabwerk",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "offscreen",
    "scripting",
    "identity",
    "favicon",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://api.typesafe.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Tabwerk öffnen"
    },
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Schnellsuche öffnen"
    },
    "tab-note": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Notiz zum aktuellen Tab"
    },
    "undo": {
      "suggested_key": {
        "default": "Alt+Shift+Z",
        "mac": "Alt+Shift+Z"
      },
      "description": "Letzte Tabwerk-Aktion rückgängig machen"
    },
    "fill-form": {
      "description": "Formular ausfüllen"
    }
  },
  "optional_permissions": [
    "bookmarks",
    "history"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/palette/*",
        "src/ui/*",
        "src/lib/*",
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
